:root {
  --bg: #0d110e;
  --bg-alt: #121813;
  --panel: #171e18;
  --border: #263227;
  --text: #dfe8e0;
  --muted: #8fa192;
  --green: #4cd137;
  --green-dark: #2e8b24;
  --green-glow: rgba(76, 209, 55, 0.25);
  --pixel: "Press Start 2P", "Courier New", monospace;
  --body: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; scroll-padding-top: 70px; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  background-image:
    linear-gradient(rgba(76, 209, 55, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(76, 209, 55, 0.035) 1px, transparent 1px);
  background-size: 32px 32px;
}

.container { width: min(1080px, 100% - 40px); margin-inline: auto; }

a { color: inherit; text-decoration: none; }
ul { list-style: none; }

/* ---------- ШАПКА ---------- */
.topbar {
  position: sticky; top: 0; z-index: 10;
  background: rgba(13, 17, 14, 0.9);
  backdrop-filter: blur(8px);
  border-bottom: 2px solid var(--border);
}
.topbar__inner {
  display: flex; align-items: center; justify-content: space-between;
  height: 60px;
}
.logo { font-family: var(--pixel); font-size: 13px; letter-spacing: 1px; }
.logo span { color: var(--green); }
.nav { display: flex; gap: 22px; }
.nav a { color: var(--muted); font-size: 15px; transition: color .2s; }
.nav a:hover { color: var(--green); }

/* ---------- КНОПКИ ---------- */
.btn {
  display: inline-block;
  padding: 15px 28px;
  font-family: var(--pixel);
  font-size: 11px;
  line-height: 1.4;
  text-align: center;
  border: 3px solid var(--green);
  cursor: pointer;
  transition: transform .12s, box-shadow .12s, background .2s, color .2s;
}
.btn--primary {
  background: var(--green);
  color: #08140a;
  box-shadow: 4px 4px 0 var(--green-dark);
}
.btn--primary:hover {
  transform: translate(-2px, -2px);
  box-shadow: 6px 6px 0 var(--green-dark);
}
.btn--primary:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--green-dark); }
.btn--ghost { background: transparent; color: var(--green); }
.btn--ghost:hover { background: var(--green); color: #08140a; }

/* ---------- HERO ---------- */
.hero {
  padding: 90px 0 70px;
  background: radial-gradient(ellipse at 50% 0%, var(--green-glow), transparent 65%);
}
.hero__inner { text-align: center; }
.badge {
  display: inline-block;
  padding: 8px 14px;
  margin-bottom: 26px;
  font-family: var(--pixel);
  font-size: 10px;
  color: var(--green);
  border: 2px solid var(--green-dark);
  background: rgba(76, 209, 55, 0.08);
}
h1 {
  font-family: var(--pixel);
  font-size: clamp(24px, 5vw, 46px);
  line-height: 1.4;
  margin-bottom: 26px;
  text-shadow: 4px 4px 0 #000;
}
h1 em { font-style: normal; color: var(--green); }
.hero__lead {
  max-width: 720px;
  margin: 0 auto 36px;
  font-size: 18px;
  color: var(--muted);
}
.hero__lead strong { color: var(--text); }
.hero__actions { display: flex; flex-wrap: wrap; gap: 18px; justify-content: center; }

.hero__stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 16px; margin-top: 60px;
}
.hero__stats li {
  padding: 20px 12px;
  background: var(--panel);
  border: 2px solid var(--border);
}
.hero__stats b {
  display: block;
  font-family: var(--pixel);
  font-size: 15px;
  color: var(--green);
  margin-bottom: 8px;
}
.hero__stats span { color: var(--muted); font-size: 14px; }

/* ---------- СЕКЦИИ ---------- */
.section { padding: 80px 0; }
.section--alt { background: var(--bg-alt); border-block: 2px solid var(--border); }
.section__title {
  font-family: var(--pixel);
  font-size: clamp(16px, 3vw, 24px);
  line-height: 1.5;
  text-align: center;
  margin-bottom: 14px;
}
.section__title::after {
  content: "";
  display: block;
  width: 80px; height: 6px;
  margin: 18px auto 0;
  background: var(--green);
  box-shadow: 0 0 14px var(--green-glow);
}
.section__sub {
  max-width: 620px;
  margin: 0 auto 46px;
  text-align: center;
  color: var(--muted);
}

/* ---------- КАРТОЧКИ ---------- */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
  gap: 22px;
}
.card {
  padding: 26px 22px;
  background: var(--panel);
  border: 2px solid var(--border);
  border-top: 5px solid var(--green);
  transition: transform .15s, box-shadow .15s, border-color .2s;
}
.card:hover {
  transform: translateY(-5px);
  border-color: var(--green-dark);
  box-shadow: 0 10px 28px var(--green-glow);
}
.card__icon { font-size: 34px; margin-bottom: 14px; }
.card h3 { font-size: 18px; margin-bottom: 10px; line-height: 1.35; }
.card p { color: var(--muted); font-size: 15px; margin-bottom: 16px; }
.card__tags { display: flex; flex-wrap: wrap; gap: 8px; }
.card__tags li {
  padding: 4px 10px;
  font-size: 12px;
  color: var(--green);
  border: 1px solid var(--green-dark);
  background: rgba(76, 209, 55, 0.07);
}

/* ---------- УСЛОВИЯ ---------- */
.terms {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}
.term {
  display: flex; gap: 18px; align-items: flex-start;
  padding: 24px;
  background: var(--panel);
  border: 2px solid var(--border);
  border-left: 5px solid var(--green);
}
.term__mark {
  flex: none;
  display: grid; place-items: center;
  width: 36px; height: 36px;
  font-weight: 700;
  color: #08140a;
  background: var(--green);
}
.term h3 { font-size: 17px; margin-bottom: 6px; }
.term p { color: var(--muted); font-size: 15px; }

/* ---------- СВЯЗЬ ---------- */
.contact {
  background: radial-gradient(ellipse at 50% 100%, var(--green-glow), transparent 65%);
}
.contact__inner { text-align: center; }
.contact__actions {
  display: flex; flex-wrap: wrap; gap: 18px; justify-content: center;
}

/* ---------- ФУТЕР ---------- */
.footer {
  padding: 28px 0;
  text-align: center;
  font-size: 13px;
  color: var(--muted);
  border-top: 2px solid var(--border);
}

/* ---------- АДАПТИВ ---------- */
@media (max-width: 640px) {
  .nav { gap: 14px; }
  .nav a { font-size: 13px; }
  .hero { padding: 60px 0 50px; }
  .hero__stats { grid-template-columns: 1fr; }
  .section { padding: 60px 0; }
  .btn { width: 100%; }
  .hero__actions, .contact__actions { flex-direction: column; }
}
